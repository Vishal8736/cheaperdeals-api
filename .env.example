# ===== Cheape Deal =====  copy to .env and fill in. NEVER commit .env.
# Generate strong secrets with:  python scripts/gen_secrets.py

# --- app ---
APP_ENV=production                 # use "development" on your Windows PC
SECRET_KEY=change-me-32+chars      # session signing
INTERNAL_API_KEY=change-me-32+chars  # n8n -> API key (header X-Internal-Key)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-password
PUBLIC_URL=https://deal.example.com   # local: http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=$
DRY_RUN=true                       # first-boot default only. After that, use the toggle in Settings.
ENABLE_DEV_TOOLS=false             # true only on your PC with mock backends (adds a test-order simulator)

# --- backends: start with mock, switch when your accounts are ready ---
SUPPLIER_BACKEND=mock              # mock (the real supplier, CJ Dropshipping, is connected with CJ_API_KEY or on the Connect page)
STORE_BACKEND=mock                 # mock | woocommerce

# WooCommerce (STORE_BACKEND=woocommerce)
WOO_BASE_URL=https://your-store.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WEBHOOK_SECRET=                # the "Secret" you type when creating the webhook in WooCommerce

# Telegram alerts (optional but strongly recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Postgres (use letters+digits only in the password: it goes inside a URL) ---
POSTGRES_USER=cheapedeal
POSTGRES_PASSWORD=change-me-letters-and-digits
POSTGRES_DB=cheapedeal

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-32+chars   # BACK THIS UP. Lose it and saved n8n credentials are unreadable.
N8N_PROTOCOL=https                  # local: http
N8N_HOST=n8n.example.com            # local: localhost
N8N_WEBHOOK_URL=https://n8n.example.com/   # local: http://localhost:5678/
N8N_SECURE_COOKIE=true              # local (http): false

# --- domains for Caddy (production only) ---
APP_DOMAIN=deal.example.com
N8N_DOMAIN=n8n.example.com

# --- v2: connectors and built-in scheduler ---
# Where connector files (.py) live. In Docker this is mounted from ./connectors.
CONNECTORS_DIR=/connectors
# Let the admin upload connector files in the UI. A connector file is code, so leave false on a public server.
ALLOW_CONNECTOR_UPLOAD=false
# Run the agents inside the app (no n8n). Leave false on the VPS where n8n schedules the jobs.
INTERNAL_SCHEDULER=false

# CJ Dropshipping: if set, the app connects CJ by itself at start-up and keeps the token fresh (no Authorize step)
CJ_API_KEY=
