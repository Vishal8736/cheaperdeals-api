{
  "rewrites": [{ "source": "/api/:path*", "destination": "https://cheapedeal.onrender.com/:path*" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" } ] },
    { "source": "/(tailwind.css|app.js|favicon.svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
