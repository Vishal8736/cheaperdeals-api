{
  "name": "cheapedeal-frontend",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o ../api/app/static/tailwind.css --minify",
    "vendor:htmx": "node -e \"require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','../api/app/static/htmx.min.js')\"",
    "build": "npm run build:css && npm run vendor:htmx"
  },
  "devDependencies": {
    "htmx.org": "1.9.12",
    "tailwindcss": "3.4.17"
  }
}
